# Инвентарь интерфейсов на тестовом устройстве.
# Каждая переменная привязана к правилу в dependencies.json через поле "env".
# Добавь новый тип: правило в dependencies.json + строка здесь — код менять не нужно.

# Физические ethernet-порты (pattern ^eth(...)$ без точки)
DEVICE_ETH_IFNAMES=eth0,eth1

# Ethernet VLAN субинтерфейсы (pattern ^eth(...).(...)$)
# DEVICE_ETH_VLAN_IFNAMES=eth0.100,eth1.200

# VLAN-интерфейсы (prefix vlan)
# DEVICE_VLAN_IFNAMES=vlan100,vlan200

# Switchport-порты (pattern ^switchport[1-8]$)
# DEVICE_SWITCHPORT_IFNAMES=switchport1,switchport2
