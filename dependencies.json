{
  "field_mappings": {
    "jail_name": {
      "requirements": ["setup", "teardown"],
      "setup": [
        {
          "endpoint": "/fail2ban/jail/add",
          "method": "POST",
          "payload": {
            "jail_name": "{{jail_name}}"
          },
          "extract_to_variable": "created_jail_name",
          "response_extract": "data.jail_name"
        }
      ],
      "teardown": [
        {
          "endpoint": "/fail2ban/jail/delete",
          "method": "POST",
          "payload": {
            "jail_name": "{{created_jail_name}}"
          }
        }
      ]
    },
    "primary_interface": {
      "optional": true,
      "setup": [
        {
        "endpoint": "/interfaces/bonding/capability",
        "method": "POST",
        "payload": {
          "ifname": "{{ifname}}",
          "capability": {
            "enslave": ["{{primary_interface}}"]
          }
        },
        "note": "Enslave primary interface before setting bond mode"
        }
      ],
      "teardown": 
      {
        "endpoint": "/interfaces/bonding/capability",
        "method": "POST",
        "payload": {
          "ifname": "{{ifname}}",
          "capability": {
            "enslave": []
          }
        },
        "note": "Enslave primary interface before setting bond mode"
        }
    },
    "pool_number": {
      "setup": {
        "endpoint": "/dhcp/ipv4/pools/add",
        "method": "POST",
        "payload": {
          "pool_number": "{{pool_number}}",
          "network": "1.1.1.0/24"
        },
        "extract_to_variable": "created_pool",
        "response_extract": "data.pool_number"
      },
      "teardown": {
        "endpoint": "/dhcp/ipv4/pools/delete",
        "method": "POST",
        "payload": {
          "pool_number": "{{created_pool}}"
        }
      }
    },
    "vrf_name": {
      "teardown_priority": 100,
      "setup": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "add",
          "vrf_name": "{{vrf_name}}"
        },
        "extract_to_variable": "created_vrf_name",
        "response_extract": "data.vrf_name"
      },
      "teardown": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "delete",
          "vrf_name": "{{vrf_name}}"
        },
        "note": "Cleanup created vrf_name"
      },
      "optional": true
    },
    "vrf": {
      "teardown_priority": 100,
      "setup": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "add",
          "vrf": "{{vrf}}"
        },
        "extract_to_variable": "created_vrf",
        "response_extract": "data.vrf"
      },
      "teardown": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "delete",
          "vrf": "{{vrf}}"
        },
        "note": "Cleanup created vrf"
      },
      "optional": true
    },
    "access_list": {
      "requirements": ["setup", "teardown"],
      "setup": {
        "endpoint": "/acl/acl_ipv4",
        "method": "POST",
        "payload": {
            "action": {
              "add": {
                "acl_name": "{{access_list}}",
                "rule": {
                  "dpi": {
                    "dpi_protocol": "sina(weibo)"
                  }
                }
              }
            }
        },
        "extract_to_variable": "created_acl_name",
        "response_extract": "data.access_list"
      },
      "teardown": {
        "endpoint": "/acl/acl_ipv4",
        "method": "POST",
        "payload": {
          "action": {
            "delete": {
              "acl_name": "{{created_acl_name}}"
            }
          }
        },
        "note": "Cleanup created access_list"
      },
      "optional": true
    },
    "acl_name": {
      "setup": {
        "endpoint": "/acl/acl_ipv4",
        "method": "POST",
        "payload": {
            "action": {
              "add": {
                "acl_name": "{{acl_name}}",
                "rule": {
                  "dpi": {
                    "dpi_protocol": "sina(weibo)"
                  }
                }
              }
            }
        },
        "extract_to_variable": "created_acl_name",
        "response_extract": "data.acl_name"
      },
      "teardown": {
        "endpoint": "/acl/acl_ipv4",
        "method": "POST",
        "payload": {
          "action": {
            "delete": {
              "acl_name": "{{acl_name}}"
            }
          }
        },
        "note": "Cleanup created acl_name"
      },
      "optional": true
    }
  },
  "endpoint_rules": {
    "/fail2ban/unban": {
      "requirements": ["setup", "teardown"],
      "setup": {
        "endpoint": "/fail2ban/enable",
        "method": "POST",
        "payload": {
          "action": "start"
        }
      },
      "teardown": {
        "endpoint": "/fail2ban/enable",
        "method": "POST",
        "payload": {
          "action": "stop"
        }
      }
    },
    "/interfaces/common/noipv6_address": {
      "bind_fields": ["ifname", "ipv6_addr"],
      "setup": {
        "endpoint": "/interfaces/common/ipv6_address",
        "method": "POST",
        "payload": {
          "ifname": "{{ifname}}",
          "ipv6_addr": "{{ipv6_addr}}"
        }
      },
      "teardown": {
        "endpoint": "/interfaces/common/noipv6_address",
        "method": "POST",
        "payload": {
          "ifname": "{{ifname}}",
          "ipv6_addr": "{{ipv6_addr}}"
        },
        "note": "Cleanup created ip_address"
      }
    },
    "/interfaces/common/noip_address": {
      "bind_fields": ["ifname", "ip_addr"],
      "setup": {
        "endpoint": "/interfaces/common/ip_address",
        "method": "POST",
        "payload": {
          "ifname": "{{ifname}}",
          "ip_addr": "{{ip_addr}}"
        }
      },
      "teardown": {
        "endpoint": "/interfaces/common/noip_address",
        "method": "POST",
        "payload": {
          "ifname": "{{ifname}}",
          "ip_addr": "{{ip_addr}}"
        },
        "note": "Cleanup created ip_address"
      }
    },
    "/interfaces/switchport/mac_address_table_static": {
      "bind_fields": ["mac_addr", "ifnames", "vlan"],
      "add": {
        "teardown": {
          "endpoint": "/interfaces/switchport/mac_address_table_static",
          "method": "POST",
          "payload": {
            "ifnames": "{{ifnames}}",
            "action": {
              "delete": {
                "mac_addr": "{{mac_addr}}",
                "vlan": "{{vlan}}"
              }
            }
          }
        }
      },
      "delete": {
        "setup": {
          "endpoint": "/interfaces/switchport/mac_address_table_static",
          "method": "POST",
          "payload": {
            "ifnames": "{{ifnames}}",
            "action": {
              "add": {
                "mac_addr": "{{mac_addr}}",
                "vlan": "{{vlan}}"
              }
            }
          },
          "note": "Создать запись перед delete-тестом"
        }
      }
    },
    "/interfaces/switchport/vlandb": {
      "bind_fields": ["vlan"],
      "add": {
        "teardown": {
          "endpoint": "/interfaces/switchport/vlandb",
          "method": "POST",
          "payload": {
            "action": "delete",
            "vlan": "{{vlan}}"
          }
        }
      },
      "delete": {
        "setup": {
          "endpoint": "/interfaces/switchport/vlandb",
          "method": "POST",
          "payload": {
            "action": "add",
            "vlan": "{{vlan}}"
          }
        }
    }
  },
    "/acl/filter/filter_ipv4": {
      "bind_fields": ["vrf", "chain", "acl_name"],
      "add": {
        "teardown": {
          "endpoint": "/acl/filter/filter_ipv4",
          "method": "POST",
          "payload": {
            "action": {
              "delete": {
                "vrf": "{{vrf}}",
                "chain": "{{chain}}",
                "acl_name": "{{acl_name}}"
              }
            }
          },
          "note": "Cleanup filter after add test"
        }
      },
      "delete": {
        "setup": [
          {
            "endpoint": "/acl/acl_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "add": {
                  "acl_name": "test_acl_name",
                  "rule": {
                    "dpi": {
                      "dpi_protocol": "sina(weibo)"
                    }
                  }
                }
              }
            },
            "note": "Create acl before delete test"
          },
          {
          "endpoint": "/acl/filter/filter_ipv4",
          "method": "POST",
          "payload": {
            "action": {
              "add": {
                "vrf": "{{vrf}}",
                "chain": "{{chain}}",
                "filter": {
                  "acl_name": "test_acl_name",
                  "action": "permit"
                }
              }
            }
          },
          "note": "Create filter before delete test"
        }
      ]
      },
      "modify": {
        "setup": [
          {
            "endpoint": "/acl/acl_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "add": {
                  "acl_name": "test_acl_name",
                  "dpi": {
                    "dpi_protocol": "sina(weibo)"
                  }
                }
              }
            }
          },
          {
          "endpoint": "/acl/filter/filter_ipv4",
          "method": "POST",
          "payload": {
            "action": {
              "add": {
                "vrf": "{{vrf}}",
                "chain": "{{chain}}",
                "filter": {
                  "acl_name": "test_acl_name",
                  "action": "permit"
                }
              }
            }
          },
          "note": "Create filter before modify test"
        }
      ],
        "teardown": [
          {
            "endpoint": "/acl/filter/filter_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "delete": {
                  "vrf": "{{vrf}}",
                  "chain": "{{chain}}"
                }
              }
            },
            "note": "Cleanup filter after modify test"
          },
          {
            "endpoint": "/acl/acl_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "delete": {
                  "acl_name": "test_acl_name"
                }
              }
            },
            "note": "Cleanup acl after modify test"
          }
      ]
      }
    }
  },
  "interface_rules": {
    "ifname": {
      "rules": [
        {
          "pattern": "^([0-9]|[1-5][0-9]|6[0-3])([\\-]([0-9]|[1-5][0-9]|6[0-3]))?([\\,]([0-9]|[1-5][0-9]|6[0-3])([\\-]([0-9]|[1-5][0-9]|6[0-3]))?)*$",
          "env": "DSCP_LIST"
        },
        {
          "pattern": "^([0-7])([\\-]([0-7]))?([\\,]([0-7])([\\-]([0-7]))?)*$",
          "env": "FPRI_LIST"
        },
        {
          "pattern": "^([1-9][0-9]{0,3}([\\-][1-9][0-9]{0,3})?)([\\,][1-9][0-9]{0,3}([\\-][1-9][0-9]{0,3})?)*$",
          "env": "VID_RANGE"
        },
        {
          "pattern": "^((eth(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3}))|(vlan([0-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5]))|([A-Za-uw-z][A-Za-z0-9_\\-]{0,30}[A-Za-z](0|[1-9][0-9]{0,3})))$",
          "env": "DEVICE_IFNAMES"
        },
        
        {
          "pattern": "^eth(0|[1-9][0-9]{0,3})([\\.](0|[1-9][0-9]{0,3}))$",
          "env": "DEVICE_ETH_VLAN_IFNAMES",
          "teardown_priority": 11,
          "setup": {
            "endpoint": "/interfaces/eth_vlan/add",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "vid": "{{vid}}"
            },
            "extract_to_variable": "created_ifname_eth_vlan",
            "response_extract": "data.ifname"
          },
          "teardown": [
            {
            "endpoint": "/interfaces/eth_vlan/delete",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            },
            "note": "Cleanup created ifname_eth_vlan"
          }
          ]
        },
        {
          "pattern": "^eth(0|[1-9][0-9]{0,3})$",
          "env": "DEVICE_ETH_IFNAMES",
          "setup": {
            "endpoint": "/interfaces/shutdown",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "adm_state": true
            },
            "note": "Reset physical ethernet to defaults"
          },
          "teardown": [{
            "endpoint": "/interfaces/common/reset_interface",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            },
            "note": "Reset physical ethernet to defaults"
          }
        ]
        },
        {
          "pattern": "^switchport[1-8]$",
          "env": "DEVICE_SWITCHPORT_IFNAMES",
          "requirements": ["setup", "teardown"],
          "setup":
            {
              "endpoint": "/interfaces/switchport/storm_control_counters",
              "method": "POST",
              "payload": {
                "ifname": "{{ifname}}",
                "unknown_multicast": {
                  "action": "start",
                  "rates": {
                    "min_rate": 306,
                    "max_rate": "unlimited"
                  }
                },
                "unknown_broadcast": {
                  "action": "start",
                  "rates": {
                    "min_rate": 306,
                    "max_rate": "unlimited"
                  }
                },
                "known_broadcast_multicast": {
                  "action": "start",
                  "rates": {
                    "min_rate": 306,
                    "max_rate": "unlimited"
                  }
                },
                "arp": {
                  "action": "start",
                  "rates": {
                    "min_rate": 306,
                    "max_rate": "unlimited"
                  }
                }
              }
              },
          "teardown": [
            {
              "endpoint": "/interfaces/switchport/storm_control_counters",
              "method": "POST",
              "payload": {
                "ifname": "{{ifname}}",
                "unknown_multicast": {
                  "action": "stop"
                },
                "unknown_broadcast": {
                  "action": "stop"
                },
                "known_broadcast_multicast": {
                  "action": "stop"
                },
                "arp": {
                  "action": "stop"
                }
              }
              },
            {
            "endpoint": "/interfaces/switchport/capability",
            "method": "POST",
            "payload": {
              "port": [
                {
                  "ifname": "{{ifname}}",
                  "autonegotiation": {
                    "on": true
                  },
                  "mtu": 10240,
                  "igmp_snooping": false,
                  "port_security": false,
                  "mac_address_table_learn_limit": null
                }
              ],
              "cpu": {
                "mac_address_table_learn_limit": null
              },
              "mac_address_table_aging_time": null,
              "dhcp_snooping": {
                "mode": false
              },
              "voicevlan": null,
              "igmp_snooping": false
            },
            "note": "Reset switchport capability to defaults"
          },
          {
            "endpoint": "/interfaces/switchport/mode",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "settings": {
                "mode": "access",
                "vlan": "untagged"
              }
            },
            "note": "Reset switchport mode to defaults"
          }
      ]},
        {
          "prefix": "bond",
          "setup_defer": true,
          "teardown_priority": 10,
          "create": "/interfaces/bonding/add",
          "delete": "/interfaces/bonding/delete"
        },
        {
          "prefix": "lo",
          "teardown_priority": 10,
          "create": "/interfaces/loopback/add",
          "delete": "/interfaces/loopback/delete"
        },
        {
          "prefix": "br",
          "teardown_priority": 10,
          "create": "/interfaces/bridge/add",
          "delete": "/interfaces/bridge/delete"
        },
        {
          "prefix": "vlan",
          "teardown_priority": 11,
          "env": "DEVICE_VLAN_IFNAMES",
          "setup": {
            "endpoint": "/interfaces/vlan/add",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "vid": "{{vid}}"
            },
            "extract_to_variable": "created_ifname_vlan",
            "response_extract": "data.ifname"
          },
          "teardown": [
            {
            "endpoint": "/interfaces/vlan/delete",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            }
          }
          ]
        },
        {
          "prefix": "tunnel",
          "teardown_priority": 10,
          "setup": {
            "endpoint": "/interfaces/tunnel/add",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "settings": {
                "source": "1.1.1.1"
              }
            },
            "extract_to_variable": "created_ifname_tunnel",
            "response_extract": "data.ifname"
          },
          "teardown": [
            {
            "endpoint": "/interfaces/tunnel/delete",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            },
            "note": "Cleanup created ifname_tunnel"
          }
          ]
        }
      ]
    }
  },
  "interface_lifecycle": {
    "schema_components": [
      "IFNAME",
      "interfaces_ethernet_ifname",
      "interfaces_eth_vlan_ifname",
      "interfaces_vlan_ifname"
    ],
    "rules_key": "ifname",
    "exclude_fields": ["jail_name"]
  },
  "mock_data": {
    "by_schema": {
      "IP_ADDR": ["10.0.0.1", "10.0.0.2", "10.0.0.3"],
      "IP_ADDR_WITH_BIT_MASK": ["10.0.0.1/24", "10.0.0.2/24", "10.0.0.3/24"],
      "IPV6_ADDR": ["2001:db8::1", "2001:db8::2"],
      "IPV6_ADDR_WITH_BIT_MASK": ["2001:db8:1::1/64", "2001:db8:2::1/64"]
    },
    "by_field": {
      "jail_name": ["jail1", "jail2"],
      "vrf_name": ["vrf1", "vrf2"],
      "vrf": ["vrf1", "vrf2"],
      "acl_name": ["acl1", "acl2"]
    }
  }
}
