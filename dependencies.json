{
  "field_mappings": {
    "vrf_name": {
      "setup": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "add",
          "vrf_name": "{{vrf_name}}"
        },
        "extract_to_variable": "created_vrf_name",
        "response_extract": "data.vrf_name"
      },
      "teardown": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "delete",
          "vrf_name": "{{vrf_name}}"
        },
        "note": "Cleanup created vrf_name"
      },
      "optional": true
    },
    "vrf": {
      "setup": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "add",
          "vrf": "{{vrf}}"
        },
        "extract_to_variable": "created_vrf",
        "response_extract": "data.vrf"
      },
      "teardown": {
        "endpoint": "/vrf",
        "method": "POST",
        "payload": {
          "action": "delete",
          "vrf": "{{vrf}}"
        },
        "note": "Cleanup created vrf"
      },
      "optional": true
    },
    "acl_name": {
      "setup": {
        "endpoint": "/acl/acl_ipv4",
        "method": "POST",
        "payload": {
            "action": {
              "add": {
                "acl_name": "{{acl_name}}",
                "rule": {
                  "dpi": {
                    "dpi_protocol": "sina(weibo)"
                  }
                }
              }
            }
        },
        "extract_to_variable": "created_acl_name",
        "response_extract": "data.acl_name"
      },
      "teardown": {
        "endpoint": "/acl/acl_ipv4",
        "method": "POST",
        "payload": {
          "action": {
            "delete": {
              "acl_name": "{{acl_name}}"
            }
          }
        },
        "note": "Cleanup created acl_name"
      },
      "optional": true
    }
  },
  "endpoint_rules": {
    "/acl/filter/filter_ipv4": {
      "bind_fields": ["vrf", "chain", "acl_name"],
      "add": {
        "teardown": {
          "endpoint": "/acl/filter/filter_ipv4",
          "method": "POST",
          "payload": {
            "action": {
              "delete": {
                "vrf": "{{vrf}}",
                "chain": "{{chain}}",
                "acl_name": "{{acl_name}}"
              }
            }
          },
          "note": "Cleanup filter after add test"
        }
      },
      "delete": {
        "setup": [
          {
            "endpoint": "/acl/acl_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "add": {
                  "acl_name": "test_acl_name",
                  "rule": {
                    "dpi": {
                      "dpi_protocol": "sina(weibo)"
                    }
                  }
                }
              }
            },
            "note": "Create acl before delete test"
          },
          {
          "endpoint": "/acl/filter/filter_ipv4",
          "method": "POST",
          "payload": {
            "action": {
              "add": {
                "vrf": "{{vrf}}",
                "chain": "{{chain}}",
                "filter": {
                  "acl_name": "test_acl_name",
                  "action": "permit"
                }
              }
            }
          },
          "note": "Create filter before delete test"
        }
      ]
      },
      "modify": {
        "setup": [
          {
            "endpoint": "/acl/acl_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "add": {
                  "acl_name": "test_acl_name",
                  "dpi": {
                    "dpi_protocol": "sina(weibo)"
                  }
                }
              }
            }
          },
          {
          "endpoint": "/acl/filter/filter_ipv4",
          "method": "POST",
          "payload": {
            "action": {
              "add": {
                "vrf": "{{vrf}}",
                "chain": "{{chain}}",
                "filter": {
                  "acl_name": "test_acl_name",
                  "action": "permit"
                }
              }
            }
          },
          "note": "Create filter before modify test"
        }
      ],
        "teardown": [
          {
            "endpoint": "/acl/filter/filter_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "delete": {
                  "vrf": "{{vrf}}",
                  "chain": "{{chain}}"
                }
              }
            },
            "note": "Cleanup filter after modify test"
          },
          {
            "endpoint": "/acl/acl_ipv4",
            "method": "POST",
            "payload": {
              "action": {
                "delete": {
                  "acl_name": "test_acl_name"
                }
              }
            },
            "note": "Cleanup acl after modify test"
          }
      ]
      }
    }
  },
  "interface_rules": {
    "ifname": {
      "rules": [
        {
          "pattern": "^((eth(0|[1-9][0-9]{0,3})\\.(0|[1-9][0-9]{0,3}))|(vlan([0-9]|[1-9][0-9]{1,2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-5]))|([A-Za-uw-z][A-Za-z0-9_\\-]{0,30}[A-Za-z](0|[1-9][0-9]{0,3})))$",
          "env": "DEVICE_IFNAMES"
        },
        
        {
          "pattern": "^eth(0|[1-9][0-9]{0,3})([\\.](0|[1-9][0-9]{0,3}))$",
          "env": "DEVICE_ETH_VLAN_IFNAMES",
          "create": "/interfaces/eth_vlan/add",
          "delete": "/interfaces/eth_vlan/delete"
        },
        {
          "pattern": "^eth(0|[1-9][0-9]{0,3})$",
          "env": "DEVICE_ETH_IFNAMES",
          "setup": {
            "endpoint": "/interfaces/shutdown",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "adm_state": true
            },
            "note": "Reset physical ethernet to defaults"
          },
          "teardown": [{
            "endpoint": "/interfaces/common/reset_interface",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            },
            "note": "Reset physical ethernet to defaults"
          }
        ]
        },
        {
          "pattern": "^switchport[1-8]$",
          "env": "DEVICE_SWITCHPORT_IFNAMES",
          "teardown": {
            "endpoint": "/interfaces/common/reset_interface",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            },
            "note": "Reset switchport to defaults"
          }
        },
        {
          "prefix": "bond",
          "create": "/interfaces/bonding/add",
          "delete": "/interfaces/bonding/delete"
        },
        {
          "prefix": "lo",
          "create": "/interfaces/loopback/add",
          "delete": "/interfaces/loopback/delete"
        },
        {
          "prefix": "br",
          "create": "/interfaces/bridge/add",
          "delete": "/interfaces/bridge/delete"
        },
        {
          "prefix": "vlan",
          "env": "DEVICE_VLAN_IFNAMES",
          "create": "/interfaces/vlan/add",
          "delete": "/interfaces/vlan/delete"
        },
        {
          "prefix": "tunnel",
          "setup": {
            "endpoint": "/interfaces/tunnel/add",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}",
              "settings": {
                "source": "1.1.1.1"
              }
            },
            "extract_to_variable": "created_ifname_tunnel",
            "response_extract": "data.ifname"
          },
          "teardown": [
            {
            "endpoint": "/interfaces/tunnel/delete",
            "method": "POST",
            "payload": {
              "ifname": "{{ifname}}"
            },
            "note": "Cleanup created ifname_tunnel"
          }
          ]
        }
      ]
    }
  }
}
