{
  "defaults": {
    "skip": [
      "vlan1",
      "vlan603",
      "switchport1",
      "default",
      "admin",
      "service",
      "startup",
      "base_config",
      "boot"
    ],
    "skip_prefix": [],
    "_comment": "Не удалять system profiles/ssh/telnet/usergroups — только тестовые ресурсы"
  },
  "rules": [
    {
      "name": "interfaces_tunnel",
      "priority": 10,
      "list": {
        "endpoint": "/interfaces/list",
        "method": "GET",
        "items_path": "result.interfaces",
        "item_filter": {
          "category": "tunnel"
        },
        "item_values": "ifname"
      },
      "delete": {
        "endpoint": "/interfaces/tunnel/delete",
        "method": "POST",
        "payload": {
          "ifname": "{{item}}"
        }
      }
    },
    {
      "name": "interfaces_vlan",
      "priority": 11,
      "list": {
        "endpoint": "/interfaces/list",
        "method": "GET",
        "items_path": "result.interfaces",
        "item_filter": {
          "category": "vlan"
        },
        "item_values": "ifname"
      },
      "delete": {
        "endpoint": "/interfaces/vlan/delete",
        "method": "POST",
        "payload": {
          "ifname": "{{item}}"
        }
      },
      "skip": [
        "vlan1",
        "vlan603"
      ]
    },
    {
      "name": "interfaces_eth_vlan",
